# LexClear Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# SQLite Database
DATABASE_URL=sqlite:///./lexclear.db

# LLM Provider Configuration (Optional: defaults to offline deterministic rule engine if unset)
# Options: "offline", "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER=offline

# API Keys (Leave blank for deterministic offline fallback mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Scoring Criteria Weights (Must sum to 1.0)
WEIGHT_CLARITY=0.25
WEIGHT_COMPLETENESS=0.20
WEIGHT_FAIRNESS=0.20
WEIGHT_LEGAL_RISK=0.25
WEIGHT_COMPLIANCE=0.10
